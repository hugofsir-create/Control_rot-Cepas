rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /materials/{materialId} {
      allow read, write: if true;
    }
    match /pallets/{palletId} {
      allow read, write: if true;
    }
    match /containers/{containerId} {
      allow read, write: if true;
    }
    match /activityLogs/{logId} {
      allow read, write: if true;
    }
  }
}
